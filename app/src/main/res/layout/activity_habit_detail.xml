<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/habit_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_2"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#70C18E" />

        <TextView
            android:id="@+id/text_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="삭제"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layout_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/text_habit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="매일 20분 걷기"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/text_habit_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026.05.01 ~ 2026.05.31"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textColor="#888888"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/text_habit_cycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="매일 20분 씩 반복(알림 설정 ON)"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textColor="#888888"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:id="@+id/layout_chart_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/habit_line_chart"
                android:layout_width="match_parent"
                android:layout_height="200dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="통계 분석 리포트"
        android:fontFamily="@font/inter"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:id="@+id/layout_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp">

            <TextView
                android:id="@+id/text_ai_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI가 분석한 통계 피드백을 불러오는 중입니다..."
                android:fontFamily="@font/inter"
                android:textSize="15sp"
                android:textColor="#555555"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_play"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.5"
            android:text="실천 시작하기"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:textColor="#FFFFFF"
            android:backgroundTint="#70C18E"
            app:cornerRadius="12dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btn_update"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="정보 수정"
            android:textSize="16sp"
            android:fontFamily="@font/inter"
            android:textColor="#70C18E"
            android:backgroundTint="#EBF7F0"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>