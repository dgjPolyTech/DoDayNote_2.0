<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/habit_list_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_2"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#70C18E" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layout_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/text_habit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="매일 20분 걷기"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/text_habit_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026.05.01 ~ 2026.05.31"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textColor="#888888"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/text_habit_cycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="매일 20분 씩 반복(알림 설정 ON)"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textColor="#888888"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:id="@+id/layout_chart_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/img_habit_chart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/chart" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="통계 분석 리포트"
        android:fontFamily="@font/inter"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:id="@+id/layout_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏆 총 31일간의 여정을 성공적으로 마무리했습니다! 최종 목표 달성률 89%를 기록하며, 계획했던 습관을 안정적으로 내면화하는 데 성공하셨습니다."
                android:fontFamily="@font/inter"
                android:textSize="15sp"
                android:textColor="#555555"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="18dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 데이터 분석 결과, 주중 오전 8시 시간대의 수행률이 96%로 가장 높게 나타났습니다. 이는 사용자님께 가장 최적화된 '습관 골든타임'임을 증명합니다."
                android:fontFamily="@font/inter"
                android:textSize="15sp"
                android:textColor="#555555"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="18dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="6dp"
                android:text="✨ 완주 성공! 이번 프로젝트를 통해 형성된 끈기는 다음 목표인 '강도 높은 운동' 단계로 진입하기 위한 훌륭한 신체적/정신적 기반이 될 것입니다."
                android:textColor="#70C18E"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">
    </LinearLayout>

</LinearLayout>