<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/record"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="20dp"
        android:gravity="center">

        <TextView
            android:id="@+id/text_total_habits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="나의 리포트"
            android:textColor="#F7F9F2"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:shadowColor="#30000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <Spinner
                android:id="@+id/spinner_year_select"
                android:layout_width="160dp"
                android:layout_height="38dp"
                android:backgroundTint="@color/main_green"
                android:spinnerMode="dropdown"
                android:paddingHorizontal="12dp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="📊 나의 습관 달성률 추이"
                android:textColor="#F7F9F2"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- MPAndroidChart BarChart 사용 (전체 연도별) -->
                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/bar_chart_habits"
                        android:layout_width="match_parent"
                        android:layout_height="260dp" />

                    <!-- MPAndroidChart LineChart 사용 (특정 연도 월별) -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/line_chart_habits"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#40FFFFFF"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="📝 주요 기록 요약"
                android:textColor="#F7F9F2"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- 동적으로 채워지는 요약 통계 텍스트 뷰에 ID 부여 -->
                    <TextView
                        android:id="@+id/text_best_year"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="✨ 데이터를 불러오는 중..."
                        android:textSize="15sp"
                        android:textColor="#334455"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/text_best_habit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text=""
                        android:textSize="15sp"
                        android:textColor="#334455"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/text_total_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text=""
                        android:textSize="15sp"
                        android:textColor="@color/main_green"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#40FFFFFF"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="🤖 AI 종합 코멘트"
                android:textColor="#F7F9F2"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- AI 로딩 중 표시용 ProgressBar -->
            <ProgressBar
                android:id="@+id/progress_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:indeterminateTint="#F7F9F2" />

            <!-- AI 코멘트 카드 — 응답 전까지 GONE, 응답 후 VISIBLE -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_ai_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/text_ai_comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text=""
                        android:textSize="15sp"
                        android:textColor="#555555"
                        android:lineSpacingExtra="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/footer_container"
        android:name="kr.ac.kopo.dodaynote_2.FooterFragment"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        tools:layout="@layout/layout_bottom_nav"/>
</LinearLayout>